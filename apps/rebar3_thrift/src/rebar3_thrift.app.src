{application, rebar3_thrift, [
    {description, "rebar3 plugin wrapping the thrift_generator IDL compiler"},
    {vsn, "0.4.0"},
    {registered, []},
    {applications, [
        kernel,
        stdlib,
        thrift_generator
    ]},
    %% rebar3 calls init/1 of the module named like the plugin only;
    %% extra providers join through this env key (rebar3_hex's pattern)
    {env, [{providers, [rebar3_thrift, rebar3_thrift_clean]}]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, []}
]}.
