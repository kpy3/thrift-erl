%% Duplicated from the umbrella root: the app directory doubles as a
%% standalone project for hex publishing (rebar3 hex runs there).
{minimum_otp_vsn, "28"}.

{erl_opts, [
    debug_info,
    warnings_as_errors
]}.

%% The provider calls the generator front end directly; the versioned
%% dep is what hex consumers get. Inside this umbrella the declared dep
%% is shadowed by the sibling app (rebar3 skips a dep whose name matches
%% a project app), so local builds always compile the local generator —
%% the requirement only resolves at publish time and for consumers.
{deps, [
    {thrift_generator, "~> 0.7.0"}
]}.

%% xref ignores for the rebar3 API calls live in the ROOT rebar.config:
%% rebar3 xref does not apply the per-app option.

%% hexdocs.pm rendering: `rebar3 hex publish` runs the ex_doc provider
%% from this directory. rebar3_ex_doc fetches the ex_doc escript itself
%% (no Elixir installation needed) and renders the EEP-48 docs chunks
%% the OTP 28+ compiler emits for -doc/-moduledoc. Duplicated per app
%% because the hex commands treat the app directory as the project.
{project_plugins, [rebar3_hex, rebar3_ex_doc]}.
{hex, [{doc, ex_doc}]}.
{ex_doc, [
    {source_url, <<"https://github.com/kpy3/thrift-erl">>},
    {extras, [<<"README.md">>]},
    {main, <<"README.md">>}
]}.

%% The `spec references type "rebar_state:t/0"' warnings during doc
%% generation are expected: rebar3 itself is not a dependency by design
%% (the host runtime provides it, same reason dialyzer excludes this
%% app); they do not fail the build.
