{erl_opts, [
    debug_info,
    warnings_as_errors
]}.

%% The provider calls the generator front end directly; consumers
%% fetch both apps together (git/path dependency on this repository).
{deps, [
    {thrift_generator, {path, "../thrift_generator"}}
]}.

%% rebar3 modules exist only inside the rebar3 runtime that loads the
%% plugin; they are intentionally not on the build's code path.
{xref_ignores, [
    {providers, create, 1},
    {rebar_state, add_provider, 2},
    {rebar_state, get, 3},
    {rebar_api, warn, 2},
    {rebar_api, info, 2},
    {rebar_api, debug, 2}
]}.
