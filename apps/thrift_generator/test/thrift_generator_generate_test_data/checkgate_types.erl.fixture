json_escape_byte(34) ->
    <<"\\\"">>;
json_escape_byte(92) ->
    <<"\\\\">>;
json_escape_byte(8) ->
    <<"\\b">>;
json_escape_byte(12) ->
    <<"\\f">>;
json_escape_byte(10) ->
    <<"\\n">>;
json_escape_byte(13) ->
    <<"\\r">>;
json_escape_byte(9) ->
    <<"\\t">>;
json_escape_byte(B) when B < 32 ->
    iolist_to_binary(io_lib:format(<<"\\u~4.16.0b">>, [B]));
json_escape_byte(B) ->
    <<B:8/big-unsigned>>.
json_field_id(Text) ->
    try
        {ok, binary_to_integer(Text)}
    catch
        _:_:_St ->
            {error, {decode, bad_field_id}}
    end.

-doc(false).
-spec json_codec(binary()) ->
                    {ok,
                     {fun((term()) -> term()), fun((term()) -> term())}} |
                    error.
json_codec(<<"Point">>) ->
    {ok,
     {fun encode_checkgate_point_json/1,
      fun decode_checkgate_point_json_body/1}};
json_codec(_Name) ->
    error.

