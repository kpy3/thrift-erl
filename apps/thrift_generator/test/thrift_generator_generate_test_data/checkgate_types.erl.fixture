    {error, {decode, bad_number}};
json_classify_number(Token, Rest, Float, Last) ->
    case Float of
        true ->
            try
                {ok, {float, binary_to_float(Token)}}
            catch
                _:_:_St
                    when
                        Rest =:= <<"">>
                        andalso
                        (Last =:= 43
                         orelse
                         Last =:= 69
                         orelse
                         Last =:= 101
                         orelse
                         Last =:= 46
                         orelse
                         Last =:= 45) ->
                    more;
                _:_:_St ->
                    {error, {decode, bad_number}}
            end;
        false ->
            try
                {ok, {int, binary_to_integer(Token)}}
            catch
                _:_:_St
                    when
                        Rest =:= <<"">>
                        andalso
                        (Last =:= 43
                         orelse
                         Last =:= 69
                         orelse
                         Last =:= 101
                         orelse
                         Last =:= 46
                         orelse
                         Last =:= 45) ->
                    more;
                _:_:_St ->
                    {error, {decode, bad_number}}
            end
    end.
json_escape(<<C:8/big-unsigned>>, Orig)
    when
        (C =/= 34
         andalso
         C =/= 92)
        andalso
        C >= 32 ->
    Orig;
json_escape(<<C:8/big-unsigned,Rest/binary>>, Orig)
    when
        (C =/= 34
         andalso
         C =/= 92)
