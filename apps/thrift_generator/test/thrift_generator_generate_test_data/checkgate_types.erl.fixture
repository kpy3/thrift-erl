                        H1:8/big-unsigned,
                        H2:8/big-unsigned,
                        H3:8/big-unsigned,
                        H4:8/big-unsigned,
                        Rest/binary>>,
                      Acc) ->
    case json_hex_value([H1, H2, H3, H4]) of
        {ok, CodePoint}
            when
                CodePoint >= 55296
                andalso
                CodePoint =< 57343 ->
            {error, {decode, bad_string_escape}};
        {ok, CodePoint} ->
            json_scan_string_body(Rest, [<<CodePoint/utf8>> | Acc]);
