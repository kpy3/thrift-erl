""
"%% Thrift IDL parser: builds #thrift_generator_node{} AST defined in"
"%% include/thrift_generator.hrl. Doc comments (`/** */`, `///`) attach to"
"%% the following definition, field or enum value; annotations on types"
"%% merge into the type tuples themselves. The entry point is"
"%% thrift_generator:ast/1; this module is generated by yecc from"
"%% src/thrift_parser.yrl.".

Nonterminals
    Document File
    Headers Header
    Include CppInclude Namespace
    Definitions Definition Def
    Typedef Struct Union Exception
    Const ConstValue ConstList ConstMap
    Enum EnumList EnumValue
    Service Extends
    FunctionList Function Oneway ReturnType Throws
    FieldList Field FieldIdentifier FieldRequired FieldDefault
    FieldType BaseType MapType SetType ListType
    Annotations Annotation AnnotationList
    Doc Separator.

Terminals
    '*' '{' '}' '[' ']' '(' ')' '=' '>' '<' ',' ':' ';'
    file doc
    include cpp_include namespace
    int ident
    bool byte i8 i16 i32 i64 double string binary uuid list map set
    true false
    typedef const enum struct union service exception
    void oneway required optional extends throws.

Rootsymbol Document.

% Document

Document -> Headers Definitions File:
    build_node(thrift_generator_document, 0, ['$3', '$1', '$2']).

File -> '$empty': undefined.
File -> file string: unwrap('$2').

% Headers

Headers -> '$empty': [].
Headers -> Header Headers: ['$1'|'$2'].

Header -> Include: '$1'.
Header -> CppInclude: '$1'.
Header -> Namespace: '$1'.

Include -> include string:
    build_node(thrift_generator_include, line('$1'), [unwrap('$2')]).

CppInclude -> cpp_include string:
    build_node(thrift_generator_cpp_include, line('$1'), [unwrap('$2')]).

Namespace -> namespace '*' ident Annotations:
    build_node(thrift_generator_namespace, line('$1'), '$4', [<<"*">>, unwrap('$3')]).
Namespace -> namespace ident ident Annotations:
    build_node(thrift_generator_namespace, line('$1'), '$4', [unwrap('$2'), unwrap('$3')]).

% Definitions

Definitions -> '$empty': [].
Definitions -> Definition Definitions: ['$1'|'$2'].

Definition -> Doc Def: set_doc('$1', '$2').

Def -> Const: '$1'.
Def -> Typedef: '$1'.
Def -> Enum: '$1'.
Def -> Struct: '$1'.
Def -> Union: '$1'.
Def -> Exception: '$1'.
Def -> Service: '$1'.

% Constants

Const -> const FieldType ident '=' ConstValue Separator:
    build_node(thrift_generator_constant, line('$1'), [unwrap('$3'), '$2', '$5']).

ConstValue -> ident: {ref, unwrap('$1')}.
ConstValue -> true: unwrap('$1').
ConstValue -> false: unwrap('$1').
ConstValue -> int: unwrap('$1').
ConstValue -> double: unwrap('$1').
ConstValue -> string: unwrap('$1').

ConstValue -> '{' ConstMap '}': {map, '$2'}.
ConstValue -> '[' ConstList ']': {list, '$2'}.

ConstMap -> '$empty': [].
ConstMap -> ConstValue ':' ConstValue Separator ConstMap: [{'$1','$3'}|'$5'].

ConstList -> '$empty': [].
ConstList -> ConstValue Separator ConstList: ['$1'|'$3'].

% Typedef

Typedef -> typedef FieldType Annotations ident Annotations Separator:
    build_node(thrift_generator_typedef, line('$1'), '$5',
               [unwrap('$4'), merge_type_annotations('$2', '$3')]).

% Enum

Enum -> enum ident '{' EnumList '}' Annotations:
    build_node(thrift_generator_enum, line('$1'), '$6', [unwrap('$2'), '$4']).

EnumList -> '$empty': [].
EnumList -> EnumValue Separator EnumList: ['$1'|'$3'].

EnumValue -> Doc ident '=' int Annotations:
    {unwrap('$2'), unwrap('$4'), '$5', '$1'}.
EnumValue -> Doc ident Annotations:
    {unwrap('$2'), undefined, '$3', '$1'}.

% Struct

Struct -> struct ident '{' FieldList '}' Annotations:
    build_node(thrift_generator_struct, line('$1'), '$6', [unwrap('$2'), '$4']).

% Union

Union -> union ident '{' FieldList '}' Annotations:
    build_node(thrift_generator_union, line('$1'), '$6', [unwrap('$2'), '$4']).

% Exception

Exception -> exception ident '{' FieldList '}' Annotations:
    build_node(thrift_generator_exception, line('$1'), '$6', [unwrap('$2'), '$4']).

% Service

Service -> service ident Extends '{' FunctionList '}' Annotations:
    build_node(thrift_generator_service, line('$1'), '$7', [unwrap('$2'), '$3', '$5']).

Extends -> extends ident: unwrap('$2').
Extends -> '$empty': undefined.

% Functions

FunctionList -> '$empty': [].
FunctionList -> Function FunctionList: ['$1'|'$2'].

Function -> Doc Oneway ReturnType ident '(' FieldList ')' Throws Annotations Separator:
    set_doc('$1',
            build_node(thrift_generator_function, line('$4'), '$9',
                       ['$2', '$3', unwrap('$4'), '$6', '$8'])).

Oneway -> '$empty': false.
Oneway -> oneway: true.

ReturnType -> void: void.
ReturnType -> FieldType: '$1'.

Throws -> '$empty': [].
Throws -> throws '(' FieldList ')': '$3'.

% Fields

FieldList -> '$empty': [].
FieldList -> Field FieldList: ['$1'|'$2'].

Field -> Doc FieldIdentifier FieldRequired FieldType Annotations ident FieldDefault Annotations Separator:
    set_doc('$1',
            build_node(thrift_generator_field, line('$6'), '$8',
                       ['$2', '$3', merge_type_annotations('$4', '$5'), unwrap('$6'), '$7'])).

FieldIdentifier -> int ':': unwrap('$1').
FieldIdentifier -> '$empty': undefined.

FieldRequired -> required: required.
FieldRequired -> optional: optional.
FieldRequired -> '$empty': default.

FieldDefault -> '$empty': undefined.
FieldDefault -> '=' ConstValue: '$2'.

% Types

FieldType -> ident: {ref, unwrap('$1'), #{}}.
FieldType -> BaseType: '$1'.
FieldType -> MapType: '$1'.
FieldType -> SetType: '$1'.
FieldType -> ListType: '$1'.

BaseType -> bool: {base, bool, #{}}.
BaseType -> byte: {base, i8, #{}}.
BaseType -> i8: {base, i8, #{}}.
BaseType -> i16: {base, i16, #{}}.
BaseType -> i32: {base, i32, #{}}.
BaseType -> i64: {base, i64, #{}}.
BaseType -> double: {base, double, #{}}.
BaseType -> string: {base, string, #{}}.
BaseType -> binary: {base, binary, #{}}.
BaseType -> uuid: {base, uuid, #{}}.

MapType -> map '<' FieldType Annotations ',' FieldType Annotations '>':
    {map, merge_type_annotations('$3', '$4'), merge_type_annotations('$6', '$7'), #{}}.
SetType -> set '<' FieldType Annotations '>': {set, merge_type_annotations('$3', '$4'), #{}}.
ListType -> list '<' FieldType Annotations '>': {list, merge_type_annotations('$3', '$4'), #{}}.

% Annotations

Annotations -> '(' AnnotationList ')': '$2'.
Annotations -> '$empty': #{}.

Annotation -> ident Separator:
    #{unwrap('$1') => true}.
Annotation -> ident '=' string Separator:
    #{unwrap('$1') => unwrap('$3')}.

AnnotationList -> '$empty': #{}.
AnnotationList -> Annotation AnnotationList: maps:merge('$1', '$2').

% Separator

Separator -> ','.
Separator -> ';'.
Separator -> '$empty'.

% Doc comments: a `doc` token produced by the lexer attaches to the
% definition, field, function or enum value that follows it.

Doc -> doc: unwrap('$1').
Doc -> '$empty': undefined.

Erlang code.

-include("thrift_generator.hrl").

% Construct a build_node AST node of the requested Type. Args are passed to
% the node module's `build_node` function and, if provided, a line number and
% annotations are assigned to the resulting node. Annotations are filtered
% down to the `erl.*` namespace before being stored on the node.

build_node(TypeModule, Args) when is_list(Args) ->
    #thrift_generator_node{
        payload = erlang:apply(TypeModule, build_node, Args),
        type_module = TypeModule
    }.

build_node(TypeModule, Line, Args) when is_integer(Line) ->
    (build_node(TypeModule, Args))#thrift_generator_node{line = Line}.

build_node(TypeModule, Line, Annotations, Args) when is_map(Annotations) ->
    Node = build_node(TypeModule, Line, Args),
    Node#thrift_generator_node{annotations = filter_erl_annotations(Annotations)}.

% Attach a doc comment (or nothing, when no comment precedes the node) to a
% node built by build_node above.

set_doc(undefined, Node) ->
    Node;
set_doc(Doc, #thrift_generator_node{} = Node) ->
    Node#thrift_generator_node{doc = Doc}.

% Extract the line number from the lexer's expression tuple.

line({_Token, Line}) -> Line;
line({_Token, Line, _Value}) -> Line.

% Return either the atom from a 2-tuple lexer expression or the processed
% value from a 3-tuple lexer expression.

unwrap({V, _}) when is_atom(V) -> V;
unwrap({_,_,V}) -> V.

% Merge annotations written after a type into the type tuple itself, so that
% every type shape carries its annotations.

merge_type_annotations({base, B, Ann}, Extra) -> {base, B, maps:merge(Ann, Extra)};
merge_type_annotations({ref, N, Ann}, Extra) -> {ref, N, maps:merge(Ann, Extra)};
merge_type_annotations({list, T, Ann}, Extra) -> {list, T, maps:merge(Ann, Extra)};
merge_type_annotations({set, T, Ann}, Extra) -> {set, T, maps:merge(Ann, Extra)};
merge_type_annotations({map, K, V, Ann}, Extra) -> {map, K, V, maps:merge(Ann, Extra)}.

% Filter annotations for the erl namespace

filter_erl_annotations(Annotations) ->
    maps:fold(
        fun
            (<<"erl.", Key/binary>>, Value, Acc) ->
                Acc#{binary_to_atom(Key, utf8) => Value};
            (_Key, _Value, Acc) ->
                Acc
        end,
        #{},
        Annotations
    ).
