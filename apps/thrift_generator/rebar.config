%% Duplicated from the umbrella root: the app directory doubles as a
%% standalone project for hex publishing (rebar3 hex runs there).
{minimum_otp_vsn, "28"}.

{erl_opts, [
    debug_info,
    warnings_as_errors
]}.

%% The lexer hands out {Line, Column} locations: tokens carry TokenLoc
%% pairs and lexical errors surface as {{L, C}, thrift_lexer, _} — the
%% diagnostic renderer puts the excerpt marker on the exact column.
%% tab_size matches the renderer's tab expansion (4 spaces per tab), so
%% columns and rendered carets agree on tab-containing lines.
{xrl_opts, [
    {error_location, column},
    {tab_size, 4}
]}.

%% scripts/bench builds the test tree with a plain `rebar3 as test
%% compile` (the ct/eunit providers inject the test source dir
%% themselves; the bench does not go through them) and loads the beams
%% from the sibling of ebin.
{profiles, [
    {test, [
        {extra_src_dirs, ["test"]}
    ]}
]}.

%% The standalone CLI escript is configured at the umbrella root
%% (rebar3 requires escript_* settings at the project level).

%% hexdocs.pm rendering: `rebar3 hex publish` runs the ex_doc provider
%% from this directory. rebar3_ex_doc fetches the ex_doc escript itself
%% (no Elixir installation needed) and renders the EEP-48 docs chunks
%% the OTP 28+ compiler emits for -doc/-moduledoc. Duplicated per app
%% because the hex commands treat the app directory as the project.
{project_plugins, [rebar3_hex, rebar3_ex_doc]}.
{hex, [{doc, ex_doc}]}.
{ex_doc, [
    {source_url, <<"https://github.com/kpy3/thrift-erl">>},
    {extras, [<<"README.md">>]},
    {main, <<"README.md">>}
]}.
