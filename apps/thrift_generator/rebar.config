{erl_opts, [
    debug_info,
    warnings_as_errors
]}.

%% The lexer hands out {Line, Column} locations: tokens carry TokenLoc
%% pairs and lexical errors surface as {{L, C}, thrift_lexer, _} — the
%% diagnostic renderer puts the excerpt marker on the exact column.
%% tab_size matches the renderer's tab expansion (4 spaces per tab), so
%% columns and rendered carets agree on tab-containing lines.
{xrl_opts, [
    {error_location, column},
    {tab_size, 4}
]}.

%% scripts/bench builds the test tree with a plain `rebar3 as test
%% compile` (the ct/eunit providers inject the test source dir
%% themselves; the bench does not go through them) and loads the beams
%% from the sibling of ebin.
{profiles, [
    {test, [
        {extra_src_dirs, ["test"]}
    ]}
]}.

%% The standalone CLI escript is configured at the umbrella root
%% (rebar3 requires escript_* settings at the project level).
