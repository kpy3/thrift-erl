{erl_opts, [
    debug_info,
    warnings_as_errors
]}.

%% scripts/bench builds the test tree with a plain `rebar3 as test
%% compile` (the ct/eunit providers inject the test source dir
%% themselves; the bench does not go through them) and loads the beams
%% from the sibling of ebin.
{profiles, [
    {test, [
        {extra_src_dirs, ["test"]}
    ]}
]}.

%% The standalone CLI escript is configured at the umbrella root
%% (rebar3 requires escript_* settings at the project level).
