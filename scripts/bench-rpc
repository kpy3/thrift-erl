#!/usr/bin/env bash
# Paired loopback RPC benchmark against a real historical git ref.
# Generates the ThriftTest service with the ref's and the current
# generator under distinct module prefixes, then runs the paired
# client/server comparison of thrift_bench_rpc on the current runtime.
# Knobs: BENCH_REGRESSION_REF, THRIFT_BENCH_ROUNDS, THRIFT_BENCH_SAMPLE_MS,
# THRIFT_BENCH_THRESHOLD, THRIFT_BENCH_FUNCTION.
set -euo pipefail
cd "$(dirname "$0")/.."
ROOT=$PWD
REF=${BENCH_REGRESSION_REF:-v0.8.0}
TEST_DIR="$ROOT/_build/test/lib/thrift_generator/test"

rebar3 as test compile >/dev/null
TMP=$(mktemp -d "$ROOT/_build/thrift-rpc-bench.XXXXXX")
trap 'rm -rf -- "$TMP"' EXIT
mkdir -p "$TMP/baseline" "$TMP/base-beams" "$TMP/head-beams"
git archive "$REF" | tar -x -C "$TMP/baseline"
(
    cd "$TMP/baseline"
    rebar3 as test compile >/dev/null
)

generate() {
    local checkout=$1
    local base=$2
    local out=$3
    (
        cd "$checkout"
        THRIFT_BENCH_BASE="$base" \
        THRIFT_BENCH_SUFFIX="" \
        THRIFT_BENCH_OUT="$out" \
        THRIFT_BENCH_IDL=apps/thrift_generator/test/thrift_golden_SUITE_data/ThriftTest.thrift \
        ERL_CRASH_DUMP_SECONDS=0 \
        erl -noshell \
            -pa "$checkout"/_build/test/lib/*/ebin \
            -pa "$TEST_DIR" \
            -eval 'thrift_bench_regression:main(["generate"])'
    )
}

generate "$TMP/baseline" goldentest080a "$TMP/base-beams"
generate "$ROOT" goldentesthead "$TMP/head-beams"

THRIFT_BENCH_BASE_BEAMS="$TMP/base-beams" \
THRIFT_BENCH_HEAD_BEAMS="$TMP/head-beams" \
ERL_CRASH_DUMP_SECONDS=0 \
erl -noshell \
    -pa "$ROOT"/_build/test/lib/*/ebin \
    -pa "$ROOT"/_build/test/lib/*/test \
    -eval 'thrift_bench_rpc:main(["compare"])'
