#!/usr/bin/env bash
# ELP lint gate. `elp lint` always exits 0 — its exit code carries no
# finding information — so this wrapper fails (exit 1) when any finding
# at warning severity or above is reported. Suppressed findings
# (.elp_lint.toml disables/exclusions) stay below the threshold and do
# not affect the gate; each suppression carries its justification there.
#
# --no-connect matches CI exactly: the standalone run is the
# deterministic one (a daemon-startup timeout silently falls back to a
# mode with a different finding set).
set -euo pipefail
cd "$(dirname "$0")/.."

TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT
if ! elp lint --rebar --as test --no-connect --ignore-app thrift --format json --severity warning \
    > "$TMP"; then
    echo "lint-elp: elp invocation failed" >&2
    exit 2
fi
if [ -s "$TMP" ]; then
    echo "lint-elp: findings at warning severity or above:" >&2
    cat "$TMP" >&2
    exit 1
fi
echo "lint-elp: clean"
