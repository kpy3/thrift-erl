%% Umbrella root: three apps under apps/ — the IDL generator, the Thrift
%% runtime used by generated code, and the rebar3 plugin wrapping the
%% generator. Shared tooling lives here, per-app build options in each
%% app's rebar.config.

{minimum_otp_vsn, "28"}.

{erl_opts, [debug_info]}.

{deps, []}.

{profiles, [
    {test, [
        {deps, [{proper, "~> 1.4"}]},
        %% The vendored official Apache Thrift Erlang runtime is a
        %% project app in the test profile only — the golden-interop
        %% fixture (see vendor/apache-thrift-erl/README-VENDORED.md).
        {project_app_dirs, ["apps/*", "vendor/apache-thrift-erl"]}
    ]}
]}.

{plugins, [
    {erlfmt, "~> 1.6"},
    {rebar3_lint, "~> 3.0"},
    {rebar3_hank, "~> 1.5"}
]}.

%% katana_code (elvis/hank dep) still uses a bare catch, which is a
%% deprecation warning on OTP 29 — and it builds itself with
%% warnings_as_errors, so the warning fails the plugin build. Silence
%% exactly that warning; the rest of its flags stay.
{overrides, [
    {add, katana_code, [{erl_opts, [nowarn_deprecated_catch]}]}
]}.

%% The standalone CLI (apps/thrift_generator's thrift_generator_cli):
%% `rebar3 as prod escriptize` builds _build/prod/lib/thrift_generator/bin/thrift_generator.
{escript_name, thrift_generator}.
{escript_main_app, thrift_generator}.
{escript_emu_args, "%%! -escript main thrift_generator_cli\n"}.
{escript_incl_apps, [thrift_generator, syntax_tools, compiler]}.

{erlfmt, [
    write,
    {print_width, 120},
    {files, [
        "apps/*/src/*.{erl,app.src}",
        "apps/*/include/*.hrl",
        "apps/*/test/*.erl",
        "apps/*/rebar.config",
        "rebar.config"
    ]}
]}.

{dialyzer, [
    {warnings, [unknown]},
    %% The rebar3 plugin needs rebar3 itself in the PLT, which the
    %% default PLT does not carry — analyze everything else.
    {exclude_apps, [rebar3_thrift]},
    {base_plt_apps, [
        erts,
        kernel,
        stdlib,
        compiler,
        syntax_tools,
        parsetools,
        crypto,
        sasl,
        public_key,
        ssl,
        runtime_tools,
        inets
    ]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions
]}.

%% rebar3 modules exist only inside the rebar3 runtime that loads the
%% plugin; they are intentionally not on the build's code path. The
%% ignores live at the root because rebar3 xref does not apply the
%% per-app rebar.config option (verified on 3.27).
{xref_ignores, [
    {providers, create, 1},
    {rebar_state, add_provider, 2},
    {rebar_state, get, 3},
    {rebar_api, warn, 2},
    {rebar_api, info, 2},
    {rebar_api, debug, 2}
]}.

%% Elvis (rebar3 lint). Vendored Apache Thrift code plays by upstream
%% rules and is not scanned; the leex/yecc outputs are generated at
%% build time. Line length mirrors the erlfmt print_width below.
%%
%% Rule deviations, all deliberate:
%% - no_spec_with_records: every gen_server specs its #state{}, the
%%   semantic model specs #tg_*{} — records in specs are the
%%   established style and dialyzer is clean;
%% - no_throw: throws are protocol here — the handler contract (a
%%   thrown exception record is the Thrift exception), the rebar3
%%   provider contract, and the loader's tagged deep-recursion errors;
%% - invalid_dynamic_call: dispatch is the design — codecs take a
%%   types module, the client loads Service:service_info/0, the CLI
%%   renders Module:format_error/1 of the failing stage;
%% - no_debug_call for the CLI: stdout/stderr output is the product of
%%   a command-line tool;
%% - atom_naming_convention for the emitter: `erl_syntax:syntaxTree()`
%%   is the library's camelCase name, quoted in remote types;
%% - export_used_types for the AST-node modules: elvis cannot see
%%   -export_type contributed through -include, and these modules
%%   re-export the shared AST vocabulary defined in the headers.
{elvis, [
    #{
        dirs => ["apps/*/src"],
        filter => "*.erl",
        ruleset => erl_files,
        rules => [
            {elvis_text_style, line_length, #{limit => 120}},
            {elvis_style, no_spec_with_records, disable},
            {elvis_style, no_throw, disable},
            {elvis_style, invalid_dynamic_call, #{
                ignore => [
                    thrift_erl_binary,
                    thrift_erl_record,
                    thrift_erl_client,
                    thrift_generator_cli
                ]
            }},
            {elvis_style, no_debug_call, #{ignore => [thrift_generator_cli]}},
            {elvis_style, atom_naming_convention, #{ignore => [thrift_generator_emitter]}},
            {elvis_style, export_used_types, #{
                ignore => [
                    thrift_generator,
                    thrift_generator_constant,
                    thrift_generator_cpp_include,
                    thrift_generator_document,
                    thrift_generator_enum,
                    thrift_generator_exception,
                    thrift_generator_field,
                    thrift_generator_function,
                    thrift_generator_include,
                    thrift_generator_namespace,
                    thrift_generator_service,
                    thrift_generator_struct,
                    thrift_generator_typedef,
                    thrift_generator_union
                ]
            }}
        ],
        ignore => [thrift_lexer, thrift_parser]
    },
    %% Tests: the Thrift IDL dictates camelCase names in the golden
    %% fixtures (testVoid, errorCode) — the wire contract wins, and the
    %% official handler throws exception records by contract. Records
    %% in test-handler specs follow the runtime's public types.
    %% begin-end inside ?FORALL/?LET is the PropEr idiom; nested
    %% try/after is the server+client resource cleanup; repeated
    %% assertion blocks are what scenario tests look like.
    #{
        dirs => ["apps/*/test"],
        filter => "*.erl",
        ruleset => erl_files,
        rules => [
            {elvis_text_style, line_length, #{limit => 120}},
            {elvis_style, function_naming_convention, #{regex => "^([a-zA-Z][a-zA-Z0-9]*_?)*$"}},
            {elvis_style, atom_naming_convention, #{regex => "^([a-zA-Z][a-zA-Z0-9]*_?)*$"}},
            {elvis_style, no_block_expressions, disable},
            {elvis_style, no_nested_try_catch, disable},
            {elvis_style, dont_repeat_yourself, disable},
            {elvis_style, no_spec_with_records, disable},
            {elvis_style, no_throw, disable}
        ]
    },
    %% Headers carry the AST records and the shared type definitions by
    %% design — every generator module includes them.
    #{
        dirs => ["apps/*/include"],
        filter => "*.hrl",
        ruleset => hrl_files,
        rules => [
            {elvis_text_style, line_length, #{limit => 120}},
            {elvis_style, no_types, disable}
        ]
    },
    #{dirs => ["."], filter => "rebar.config", ruleset => rebar_config}
]}.

%% Hank (rebar3 hank) — dead-code sweep. Ignored paths:
%% - vendored Apache Thrift runtime and the committed golden code:
%%   upstream/reference artifacts, not ours to clean;
%% - the leex/yecc outputs, generated at build time.
%% Kept signatures the contracts require:
%% - the service behaviour declares service_info/0; the client loads it
%%   dynamically, so the defining module never calls it;
%% - handler functions keep arity even when a fixture ignores the
%%   argument (canonical testMapMap answers without reading input);
%% - CT suite callbacks take Config by signature;
%% - generate/3 keeps its arity — Opts is a reserved API slot.
%% AST node records live in the shared header by design; each kind is
%% consumed by its own build module.
{hank, [
    {ignore, [
        "vendor/**",
        "apps/*/priv/**",
        "apps/*/src/thrift_lexer.erl",
        "apps/*/src/thrift_parser.erl",
        {"apps/thrift_erl/src/thrift_erl_service.erl", unused_callbacks},
        {"apps/thrift_generator/include/thrift_generator.hrl", single_use_hrl_attrs},
        {"apps/thrift_generator/src/thrift_generator.erl", unnecessary_function_arguments},
        {"apps/thrift_erl/test/thrift_erl_SUITE.erl", unnecessary_function_arguments},
        {"apps/thrift_generator/test/thrift_golden_SUITE.erl", unnecessary_function_arguments},
        {"apps/thrift_generator/test/thrift_golden_our_handler.erl", unnecessary_function_arguments},
        {"apps/thrift_generator/test/thrift_golden_official_handler.erl", unnecessary_function_arguments}
    ]}
]}.
