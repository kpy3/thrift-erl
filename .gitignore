# leex/yecc outputs are generated at build time
apps/*/src/thrift_lexer.erl
apps/*/src/thrift_parser.erl
# hex packaging: project-wide files copied into the app dirs by
# scripts/hex-prepublish before `rebar3 hex build/publish`, which runs
# with the app dir as the project root
apps/*/CHANGELOG.md
apps/*/LICENSE.md
# ex_doc HTML from a standalone `rebar3 ex_doc` in an app dir
apps/*/doc/
# standalone builds from an app dir (hex workflows) drop their own lock
apps/*/rebar.lock
.zcode/
vendor/apache-thrift-erl/rebar.lock
# project-local agent instructions: kept in the working tree, not in git
AGENTS.md
